{
  "name": "scamdown",
  "version": "0.1.0",
  "description": "Report scam and phishing links to every party that can take them down: blocklists, host, CDN, registrar, network. CLI, MCP server and web page.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/agtt/scamdown.git" },
  "homepage": "https://github.com/agtt/scamdown",
  "funding": [
    { "type": "buymeacoffee", "url": "https://buymeacoffee.com/agtt" },
    { "type": "github", "url": "https://github.com/sponsors/agtt" }
  ],
  "keywords": ["phishing", "scam", "abuse", "takedown", "report", "rdap", "mcp", "security"],
  "bin": { "scamdown": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "public"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "bun test",
    "dev": "bun src/cli.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "nodemailer": "^10.2.1",
    "postal-mime": "^4.1.4",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
